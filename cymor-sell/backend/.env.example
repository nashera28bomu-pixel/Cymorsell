NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cymor-sell

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Main Cymor Sell management bot (for business owners) - from BotFather
TELEGRAM_MAIN_BOT_TOKEN=

# Numeric Telegram user ID of the platform admin (NOT a username)
ADMIN_TELEGRAM_ID=

# Optional secondary admin login (server-side only, never sent to frontend)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

GEMINI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Telegram deep-link token secret (short-lived link tokens between bot <-> web)
LINK_TOKEN_SECRET=replace_with_another_random_string

# Set true to disable public signups / put platform in maintenance at boot (optional override)
FORCE_MAINTENANCE=false
